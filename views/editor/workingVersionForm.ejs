<form id="working-version-form">

    <div class="form-group">
        <label for="title">Title</label>

        <input
            type="text"
            id="title"
            name="title"
            maxlength="200"
            value="<%= article.workingVersion?.title || "" %>"
            required
        >
    </div>

    <div class="form-group">
        <label for="summary">Summary</label>

        <textarea
            id="summary"
            name="summary"
            maxlength="500"
        ><%= article.workingVersion?.summary || "" %></textarea>
    </div>

    <div class="form-group">
        <label for="category">Category</label>

        <input
            type="text"
            id="category"
            name="category"
            value="<%= article.workingVersion?.category || "" %>"
        >
    </div>

    <div class="form-group">
        <label for="mainImage">Main Image</label>

        <input
            type="text"
            id="mainImage"
            name="mainImage"
            value="<%= article.workingVersion?.mainImage || "" %>"
        >
    </div>

    <div class="form-group">
        <label for="content">Content</label>

        <textarea
            id="content"
            name="content"
            class="content-input"
            required
        ><%= article.workingVersion?.content || "" %></textarea>
    </div>

    <button type="submit" class="save-button">
        Save Changes
    </button>

</form>