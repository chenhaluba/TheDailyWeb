
    <article class="main-article">
    
        <div class="main-article-image">
    
            <img
            src="/images/<%= mainArticle.publishedVersion.mainImage %>"
            alt="<%= mainArticle.publishedVersion.title %>">
    
        </div>
    
        <div class="main-article-content">
    
            <span class="main-article-category">
                <%= mainArticle.publishedVersion.category %>
            </span>
    
            <h1>
                <%= mainArticle.publishedVersion.title %>
            </h1>
            
            <div class="article-card-meta">
                <span>By <%= mainArticle.author?.displayName || "Unknown Author" %></span>
                <span><%= mainArticle.publishedVersion.savedAt
                    ? new Date(mainArticle.publishedVersion.savedAt).toLocaleDateString("en-US")
                    : "" %></span>
            </div>
    
            <p>
                <%= mainArticle.publishedVersion.summary %>
            </p>
    
            <a
                href="/articles/<%= mainArticle._id %>"
                class="read-more-btn">
    
                Read More →
    
            </a>
    
        </div>
    
    </article>