<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>

    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/home.css">
</head>

<body>

    <%- include("../partials/header") %>

    <main class="container">

        <% if (mainArticle) { %>

            <!-- Weather Widget -->
            <section id="weather-section">
                <%- include("../partials/weatherWidget") %>
            </section>

            <!-- Main Article -->
            <section id="main-article-section">

                <h2 class="section-title">
                    Top Story
                </h2>

                <%- include("../partials/mainArticle") %>

            </section>

        <% } %>

        <!-- Search -->
        <section id="filters-section">

            <form id="search-form" method="GET" action="/">

                <input
                    type="text"
                    id="search-input"
                    name="search"
                    value="<%= search || '' %>"
                    placeholder="Search by title...">

                <% if (sort) { %>
                    <input
                        type="hidden"
                        name="sort"
                        value="<%= sort %>">
                <% } %>

                <% if (category) { %>
                    <input
                        type="hidden"
                        name="category"
                        value="<%= category %>">
                <% } %>

                <button
                    id="search-button"
                    type="submit">
                    🔍 Search
                </button>

            </form>

        </section>

        <!-- Articles -->
        <section id="articles-section">

            <div class="articles-toolbar">

                <div>

                    <% if (search) { %>

                        <h2 class="section-title">
                            Search Results
                        </h2>
                    
                        <p class="results-count">
                            Found
                            <strong><%= resultsCount %></strong>
                            article(s) matching
                            "<strong><%= search %></strong>"
                        </p>
                    
                    <% } else if (category) { %>
                    
                        <h2 class="section-title">
                            <%= category %> News
                        </h2>
                    
                        <p class="results-count">
                            Showing
                            <strong><%= resultsCount %></strong>
                            article(s)
                        </p>
                    
                    <% } else { %>
                    
                        <h2 class="section-title">
                            Latest News
                        </h2>
                    
                    <% } %>
                </div>

                <form
                    id="sort-form"
                    method="GET"
                    action="/">

                    <% if (search) { %>

                        <input
                            type="hidden"
                            name="search"
                            value="<%= search %>">

                    <% } %>

                    <% if (category) { %>

                        <input
                            type="hidden"
                            name="category"
                            value="<%= category %>">
                    
                    <% } %>

                    <label for="sort-filter">
                        Sort by
                    </label>

                    <select
                        id="sort-filter"
                        name="sort"
                        onchange="this.form.submit()">

                        <option
                            value="newest"
                            <%= sort === "newest" ? "selected" : "" %>>
                            Newest
                        </option>

                        <option
                            value="popular"
                            <%= sort === "popular" ? "selected" : "" %>>
                            Most Viewed
                        </option>

                    </select>

                </form>

            </div>

            <div class="articles-grid">

                <% if (articles && articles.length > 0) { %>

                    <% articles.forEach(article => { %>

                        <%- include("../partials/articleCard", { article }) %>

                    <% }) %>

                <% } else { %>

                    <div class="empty-state">

                        <% if (search) { %>

                            <h3>No results found</h3>

                            <p>
                                We couldn't find any articles matching
                                "<strong><%= search %></strong>".
                            </p>

                        <% } else { %>

                            <h3>No articles available</h3>

                            <p>
                                There are currently no published articles.
                            </p>

                        <% } %>

                    </div>

                <% } %>

            </div>

        </section>

    </main>

    <%- include("../partials/footer") %>

</body>

</html>