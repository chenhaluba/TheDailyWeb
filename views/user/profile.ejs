<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= pageTitle %> | The Daily Web
    </title>
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/reporter.css">
    <style>
        .profile-container {
            max-width: 600px;
            margin: 60px auto;
            background: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        }

        .profile-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            border-bottom: 1px solid #eee;
            padding-bottom: 20px;
        }

        .profile-header h2 {
            font-size: 1.8rem;
            color: #222;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #444;
        }

        .form-control {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 1rem;
            transition: 0.2s;
        }

        .form-control:focus {
            outline: none;
            border-color: #0d6efd;
            box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.2);
        }

        .form-control[readonly] {
            background-color: #f7f8fa;
            color: #777;
            cursor: not-allowed;
        }

        .btn-group {
            display: flex;
            gap: 15px;
            margin-top: 30px;
        }

        .btn-danger {
            background: #dc3545;
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 1rem;
            transition: 0.2s;
        }

        .btn-danger:hover {
            background: #c82333;
        }
    </style>
</head>

<body>
    <%- include("../partials/header") %>

        <main class="container">
            <div class="profile-container">
                <div class="profile-header">
                    <h2>My Profile</h2>
                    <a href="/<%= user.role %>/dashboard" id="dashboard-btn" class="primary-button">My Dashboard</a>
                </div>

                <form id="profile-form">
                    <div class="form-group">
                        <label for="username">Username</label>
                        <input type="text" id="username" class="form-control" value="<%= user.username %>" readonly>
                        <small style="color: #666; margin-top: 4px; display: block;">Username cannot be changed.</small>
                    </div>

                    <div class="form-group">
                        <label for="displayName">Display Name</label>
                        <input type="text" id="displayName" class="form-control" value="<%= user.displayName || '' %>"
                            placeholder="Update your name">
                    </div>

                    <div class="form-group">
                        <label for="newPassword">New Password</label>
                        <input type="password" id="newPassword" class="form-control"
                            placeholder="Leave blank to keep current">
                    </div>

                    <div class="btn-group">
                        <button type="submit" class="primary-button">Update Profile</button>
                        <button type="button" id="delete-account-btn" class="btn-danger">Delete Account</button>
                    </div>
                </form>
            </div>
        </main>

        <%- include("../partials/footer") %>

            <script>

                document.getElementById('dashboard-btn').addEventListener('click', () => {
                    console.log("Redirect logic will run here");
                });

                document.getElementById('profile-form').addEventListener('submit', async (e) => {
                    e.preventDefault();

                    const isConfirmed = confirm("Are you sure you want to update your profile?");
                    if (!isConfirmed) return;

                    const username = document.getElementById('username').value;
                    const displayName = document.getElementById('displayName').value;
                    const newPassword = document.getElementById('newPassword').value;

                    const updateData = {
                        username: username,
                        newDisplayName: displayName
                    };

                    if (newPassword.trim() !== '') {
                        updateData.newPassword = newPassword;
                    }

                    try {
                        const response = await fetch('/user', {
                            method: 'PUT',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify(updateData)
                        });

                        const data = await response.json();

                        if (response.ok) {
                            alert('Profile updated successfully!');
                            document.getElementById('newPassword').value = '';
                        } else {
                            alert(data.message || 'Failed to update profile.');
                        }
                    } catch (err) {
                        console.error('Error updating profile:', err);
                        alert('An error occurred while updating your profile.');
                    }
                });

                document.getElementById('delete-account-btn').addEventListener('click', async () => {
                    const isConfirmed = confirm("Are you sure you want to PERMANENTLY delete your account? This action cannot be undone.");
                    if (!isConfirmed) return;
                    const password = prompt("Please enter your password to confirm account deletion:");
                    if (!password) return;
                    const username = document.getElementById('username').value;
                    try {
                        const response = await fetch('/user', {
                            method: 'DELETE',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ username, password })
                        });
                        const data = await response.json();
                        if (response.ok) {
                            alert('Your account has been deleted.');
                            window.location.href = data.redirect || '/login';
                        } else {
                            alert(data.message || 'Failed to delete account.');
                        }
                    } catch (err) {
                        console.error('Error deleting account:', err);
                        alert('An error occurred while deleting your account.');
                    }
                });
            </script>
</body>

</html>